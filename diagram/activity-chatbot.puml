@startuml activity-chatbot
skinparam activityBackgroundColor #dae8fc
skinparam activityBorderColor #6c8ebf
skinparam arrowColor #333333

start
:Membuka widget chatbot;
:Mengetik pesan;
:Sistem mendeteksi keyword;
if (Keyword dikenali?) then (ya)
  :Sistem menampilkan respons otomatis;
else (tidak)
  :Sistem menampilkan pesan fallback\n"Silakan hubungi sales kami";
endif
if (Lanjut bertanya?) then (ya)
  :Kembali mengetik pesan;
  back to :Sistem mendeteksi keyword;
else (tidak)
  :Menutup widget chatbot;
endif
stop

@enduml